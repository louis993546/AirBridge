# Optional local device configuration (copy to `cfg.toml`; gitignored).
# If `cfg.toml` is not present, generic placeholders are used so the project still builds out of the box.
#
# Tip: To discover your real IPP-USB printer's UUID, URF, and PDL values, flash once with defaults,
# plug in the printer, and run on macOS:
#   ipptool -tv ipp://<p4-ip>:631/ipp/print /usr/share/cups/ipptool/get-printer-attributes.test \
#     | grep -E "printer-uuid|printer-make-and-model|document-format-supported|urf-supported"

MDNS_HOSTNAME = "p4-airbridge"
PRINTER_NAME = "P4 AirBridge Printer"
PRINTER_MODEL = "Generic IPP-USB MFP"
PRINTER_PRODUCT = "(Generic IPP-USB MFP)"
PRINTER_SERIAL = "P4-AIRBRIDGE-001"
PRINTER_UUID = "00000000-0000-4000-8000-000000000001"
PRINTER_PDL = "application/octet-stream,image/pwg-raster,image/urf,image/jpeg"
PRINTER_URF = "W8,SRGB24,RS300-600,DM1,PQ4"
SCANNER_PDL = "application/pdf,image/jpeg"
SCANNER_CS = "color,grayscale,binary"

# Optional Wi-Fi 6 (WPA3) via onboard ESP32-C6 over SDIO.
# Leave empty to use Ethernet only; if set, Wi-Fi connects automatically (Ethernet remains active too).
WIFI_SSID = ""
WIFI_PASS = ""
WIFI_COUNTRY = "EU"

# Optional shared secret for wireless OTA firmware updates (`POST /ota`).
# Leave empty to allow any device on your local LAN to upload firmware.
OTA_TOKEN = ""

# Optional local ESP-IDF tools path override used by ./flash-usb.sh and ./ota.sh
# (e.g. "global" or "custom:/path/to/espressif")
# ESP_IDF_TOOLS_INSTALL_DIR = "global"
