# Stack sizes for Rust std tasks
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# Waveshare ESP32-P4-Module-DEV-KIT: 16MB Flash + 32MB Hex PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# Automatic OTA rollback protection (reverts to previous slot if new firmware fails to boot/connect)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Ethernet (ESP32-P4 internal EMAC + IP101GRI RMII PHY)
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_PHY_INTERFACE_RMII=y

# HTTP Server limits (macOS Image Capture & CUPS send larger headers/URIs)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_ERR_RESP_NO_DELAY=y

# Networking (enough sockets for port 80 AirScan + port 631 AirPrint + mDNS)
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_SO_REUSE=y

# Console over native USB-Serial/JTAG (the port we flash & monitor on)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# USB 2.0 Host + Hub support (required for Waveshare P4 onboard CH334F 4-port USB-A hub!)
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024
